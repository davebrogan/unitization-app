@{
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? "Rehearsal Forecast"
        : $"{pageTitle} — Rehearsal Forecast";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@fullTitle</title>
    @* Pico CSS v2.1.1 — modern semantic styling for native HTML elements
       (typography, buttons, inputs, tables, focus states, light/dark themes).
       Loaded first so app-specific rules in site.css can override it. *@
    <link rel="stylesheet" href="~/css/vendor/pico.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="site-header__inner">
            <a class="site-header__brand" href="@Url.Action("Index", "Forecast")">Rehearsal Forecast</a>
        </div>
    </header>

    <main class="site-main" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer__inner">
            <span>Rehearsal Forecast · 36-month planning tool</span>
        </div>
    </footer>
</body>
</html>
